# Copier en .env sur le serveur (jamais dans Git).
# Utiliser un serveur SMTP situé dans l'UE (ex. celui de l'hébergeur, ou un relais de messagerie européen).
SMTP_HOST=smtp.exemple-ue.eu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@financiale.fr
SMTP_PASS=change-moi
MAIL_FROM="Site Financiale <no-reply@financiale.fr>"
MAIL_TO=contact@financiale.fr
ALLOWED_ORIGIN=https://www.financiale.fr
