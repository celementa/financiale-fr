---
import Arrow from './Arrow.astro';
interface Props { href: string; label: string; variant?: 'dark' | 'light' | 'gold'; class?: string }
const { href, label, variant = 'dark', class: cls } = Astro.props;
---
<a href={href} class:list={['btn', variant !== 'dark' && `btn--${variant}`, cls]}>
  <span>{label}</span>
  <span class="btn__arrow"><Arrow size={14} /></span>
</a>
