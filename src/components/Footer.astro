---
import { url } from '../lib/url';
import { site } from '../lib/data';
import Img from './Img.astro';
const f = site.footer;
const icons: Record<string, string> = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>',
  facebook: '<circle cx="12" cy="12" r="9"/><path d="M13.5 8.5h-1.2c-.9 0-1.3.5-1.3 1.3V21M9 13h5"/>',
  youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="m10 9 5 3-5 3z" fill="currentColor"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7.5 10v6.5M7.5 7.3v.2M11 16.5V10m0 3c0-2 1-3 2.5-3s2.5 1 2.5 3v3.5"/>',
};
const social = Object.entries(f.social ?? {}).filter(([, url]) => url);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <nav class="site-footer__cols" aria-label="Pied de page">
        {f.columns.map((col: any) => (
          <div>
            <p class="site-footer__title">{col.title}</p>
            <ul>{col.links.map((l: any) => <li><a href={url(l.href)}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
      <div class="site-footer__aside">
        <p class="site-footer__tagline">{f.tagline}</p>
        {social.length > 0 && (
          <ul class="site-footer__social">
            {social.map(([name, url]) => (
              <li><a href={url as string} rel="noopener" target="_blank" aria-label={name}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" set:html={icons[name]} />
              </a></li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class="site-footer__brand">
      <div>
        <!-- Logo volontairement petit et aligné à gauche -->
        <a href={url('/')} class="site-footer__logo" aria-label="Financiale — accueil">
          <Img src={site.logoLight} alt="Financiale Gestion Privée" sizes="140px" widths={[140, 280]} />
        </a>
        <address>
          {site.address.street} – {site.address.postalCode} {site.address.city}<br />
          <a href={`tel:${site.phoneIntl}`}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      </div>
      <p class="site-footer__meta">
        © Copyright {year} · <a href={f.credit.href} rel="noopener">{f.credit.label}</a>
      </p>
    </div>

    <p class="site-footer__legal">{f.legal}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: var(--paper); padding: clamp(3.5rem, 6vw, 5rem) 0 2.5rem; }
  .site-footer__top { display: grid; grid-template-columns: 1fr auto; gap: 3rem; }
  .site-footer__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 13rem)); gap: 2rem; }
  .site-footer__title { font-size: .875rem; font-weight: 500; text-transform: uppercase; color: rgba(255,252,245,.5); margin-bottom: 1.25rem; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; }
  .site-footer__cols li { margin-bottom: .6rem; font-size: 1rem; line-height: 1.35; }
  .site-footer__cols a:hover, .site-footer address a:hover, .site-footer__meta a:hover { color: var(--gold); }
  .site-footer__aside { text-align: right; }
  .site-footer__tagline { font-family: var(--font-display); font-size: 1.5rem; font-weight: 300; max-width: 22rem; margin-left: auto; line-height: 1.25; }
  .site-footer__social { display: flex; gap: .9rem; justify-content: flex-end; margin-top: 1.5rem !important; }
  .site-footer__social a:hover { color: var(--gold); }

  .site-footer__brand {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap;
    margin-top: clamp(3rem, 6vw, 5rem); padding-top: 2rem; border-top: 1px solid var(--line-light);
  }
  .site-footer__logo { display: block; width: 140px; margin-bottom: 1.25rem; }
  .site-footer__logo :global(img) { width: 140px; height: auto; }
  .site-footer address { font-style: normal; font-size: 1rem; line-height: 1.7; }
  .site-footer__meta { font-size: var(--fs-small); margin: 0; }
  .site-footer__legal {
    margin-top: 2rem; font-size: .75rem; line-height: 1.6; color: rgba(255,252,245,.5);
  }

  @media (max-width: 900px) {
    .site-footer__top { grid-template-columns: 1fr; }
    .site-footer__aside { text-align: left; }
    .site-footer__tagline { margin-left: 0; }
    .site-footer__social { justify-content: flex-start; }
  }
  @media (max-width: 640px) { .site-footer__cols { grid-template-columns: 1fr 1fr; } }
</style>
