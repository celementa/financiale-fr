---
/** Appel à l'action final : grande image, titre centré, bouton. */
import Img from '../Img.astro';
import Button from '../Button.astro';
const { title, text, image, cta } = Astro.props;
---
<section class="section cta">
  <div class="container">
    <div class="cta__box reveal">
      <div class="cta__bg"><Img src={image} alt="" sizes="(max-width: 1300px) 95vw, 1240px" /></div>
      <h2 class="h1">{title}</h2>
      <p class="lead">{text}</p>
      {cta && <Button href={cta.href} label={cta.label} variant="gold" />}
    </div>
  </div>
</section>

<style>
  .cta__box {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: clamp(460px, 60vw, 700px);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem;
    padding: clamp(3rem, 8vw, 6rem) var(--gutter);
    color: var(--paper); text-align: center; background: var(--navy);
  }
  .cta__bg { position: absolute; inset: 0; z-index: -1; }
  .cta__bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cta__box::after { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(8, 8, 8, .38); }
  .cta__box h2 { max-width: 14em; }
  .cta__box p { max-width: 42rem; margin-bottom: 2.5rem; }
</style>
