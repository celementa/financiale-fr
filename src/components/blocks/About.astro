---
/** « Qui sommes-nous » : texte + image + chiffres clés en escalier. */
import Img from '../Img.astro';
import Heading from '../Heading.astro';
import LinkArrow from '../LinkArrow.astro';
const { eyebrow, title, text, link, image, stats = [] } = Astro.props;
---
<section class="section about">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <div class="about__grid reveal">
      <div class="about__text">
        <Heading as="h2" text={title} class="h4" />
        <p class="about__body">{text}</p>
        {link && <LinkArrow href={link.href} label={link.label} />}
      </div>
      <div class="media about__media"><Img src={image} alt="" sizes="(max-width: 900px) 90vw, 400px" /></div>
    </div>

    <ul class="about__stats">
      {stats.map((s: any, i: number) => (
        <li class="reveal" style={`--i:${i}`}>
          <span class="about__value">{s.value}</span>
          <span class="about__label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about__grid { display: grid; grid-template-columns: 1fr 400px; gap: clamp(2rem, 6vw, 6rem); align-items: start; padding-left: clamp(0rem, 8vw, 8rem); }
  .about__body { max-width: 32rem; margin: 2.5rem 0 3rem; font-size: var(--fs-small); line-height: 1.6; }
  .about__media { aspect-ratio: 399 / 656; }
  .about__stats { list-style: none; padding: 0; margin: clamp(4rem, 9vw, 8rem) 0 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .about__stats li {
    display: flex; flex-direction: column; justify-content: space-between; gap: 3rem;
    border-left: 1px solid var(--line-dark); padding: .25rem 0 .25rem 1rem;
    margin-top: calc(var(--i) * clamp(0rem, 9vw, 9rem));
  }
  .about__value { font-family: var(--font-display); font-size: var(--fs-h1); font-weight: 300; color: var(--navy); line-height: 1; }
  .about__label { font-size: var(--fs-small); font-weight: 500; text-transform: uppercase; }
  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; padding-left: 0; }
    .about__media { max-width: 420px; }
    .about__stats { grid-template-columns: 1fr 1fr; gap: 2.5rem 0; }
    .about__stats li { margin-top: 0; }
  }
</style>
