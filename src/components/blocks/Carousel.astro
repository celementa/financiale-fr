---
/** Carrousel horizontal de cartes (image + titre + texte), défilement natif + flèches.
 *  tone: "dark" (fond bleu) | "light" */
import Img from '../Img.astro';
import Arrow from '../Arrow.astro';
const { eyebrow, title, text, items = [], tone = 'dark' } = Astro.props;
---
<section class:list={['section carousel', tone === 'dark' ? 'section--navy' : 'section--paper']} data-carousel>
  <div class="container">
    <div class="divider"><p class="eyebrow">{eyebrow}</p></div>
    <div class="section-head section-head--split">
      <div>
        <h2>{title}</h2>
        {text && <p class="carousel__intro">{text}</p>}
      </div>
      <div class="carousel__nav">
        <button type="button" data-prev aria-label="Précédent"><Arrow dir="left" size={14} /></button>
        <button type="button" data-next aria-label="Suivant"><Arrow size={14} /></button>
      </div>
    </div>
  </div>
  <ul class="carousel__track" data-track>
    {items.map((it: any) => (
      <li class="carousel__card">
        <div class="media"><Img src={it.image} alt="" sizes="(max-width: 760px) 80vw, 400px" /></div>
        <div class="carousel__body">
          <h3 class="h4">{it.title}</h3>
          <p>{it.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .carousel__intro { margin-top: 1.25rem; max-width: 36rem; }
  .carousel__nav { display: flex; gap: .5rem; }
  .carousel__nav button {
    width: 2.25rem; height: 2.25rem; display: grid; place-items: center; cursor: pointer;
    background: var(--bronze); color: var(--paper); border: 0;
  }
  .carousel__nav button:hover { background: var(--gold); }
  .carousel__track {
    list-style: none; margin: 0; padding: 0 max(var(--gutter), calc((100vw - var(--container)) / 2));
    display: grid; grid-auto-flow: column; grid-auto-columns: clamp(260px, 32vw, 392px); gap: 1rem;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2));
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar { display: none; }
  .carousel__card { position: relative; scroll-snap-align: start; color: var(--paper); aspect-ratio: 392 / 520; overflow: hidden; }
  .carousel__card .media { position: absolute; inset: 0; }
  .carousel__card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,8,8,0) 35%, rgba(8,8,8,.8) 100%); }
  .carousel__body { position: absolute; left: 1.25rem; right: 1.25rem; bottom: 1.25rem; z-index: 1; }
  .carousel__body h3 { margin-bottom: .6rem; }
  .carousel__body p { font-size: .875rem; line-height: 1.45; }
</style>

<script>
  import '../../scripts/carousel';
</script>
