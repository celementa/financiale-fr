---
/** Rangée de chiffres clés. */
const { items = [] } = Astro.props;
---
<section class="section section--tight stats">
  <div class="container">
    <ul class="stats__list">
      {items.map((s: any) => (
        <li class="reveal"><span class="stats__value">{s.value}</span><span class="stats__label">{s.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .stats__list li { display: flex; flex-direction: column; gap: 2.5rem; padding-left: 1rem; border-left: 1px solid var(--line-dark); }
  .stats__value { font-family: var(--font-display); font-weight: 300; font-size: var(--fs-h1); line-height: 1; color: var(--navy); }
  .stats__label { font-size: var(--fs-small); font-weight: 500; text-transform: uppercase; }
  @media (max-width: 760px) { .stats__list { grid-template-columns: 1fr 1fr; gap: 2.5rem 0; } }
</style>
